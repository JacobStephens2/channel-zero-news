[Unit]
Description=The Channel 0 News realtime backend (Rust/Axum)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=jacob
Group=jacob
WorkingDirectory=/var/www/channel0.stephens.page
EnvironmentFile=/var/www/channel0.stephens.page/.env
Environment=CHANNEL_ZERO_ADDR=127.0.0.1:3471
Environment=CHANNEL_ZERO_STATIC=/var/www/channel0.stephens.page/static
Environment=RUST_LOG=info,channel_zero=info
ExecStart=/var/www/channel0.stephens.page/target/release/channel-zero
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
